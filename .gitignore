.env*.local
.env.development
.env.test
.env
!.env.example
!.env.production.example
!.env.development.example

# local env files for backend
backend/.env*
!backend/.env.example
!backend/.env.production.example
!backend/.env.development.example

# EAS secrets (Expo)
.eas-build-secrets/

