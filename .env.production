# Frontend - Production (Expo/Vercel)
# Use this template to set environment variables in EAS or CI/CD pipeline
# For EAS: eas secret create to store sensitive values
# For Vercel: Settings -> Environment Variables

# Backend API Configuration (must be production URL)
VITE_API_BASE_URL=https://your-backend-url.onrender.com
VITE_API_TIMEOUT=30000

# Socket.IO Configuration (must match backend)
VITE_SOCKET_URL=https://your-backend-url.onrender.com

# Google Maps API (use production keys)
VITE_GOOGLE_MAPS_API_KEY_IOS=YOUR_PRODUCTION_IOS_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY_ANDROID=YOUR_PRODUCTION_ANDROID_GOOGLE_MAPS_API_KEY

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=false
VITE_ENABLE_MOCK_DATA=false

# Environment Type
VITE_ENV=production
