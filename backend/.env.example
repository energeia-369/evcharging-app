# Server configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/evcharging_app

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend access
CORS_ORIGIN=*

# Optional request tuning
JSON_LIMIT=1mb