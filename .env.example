# Frontend - Environment Variables Example
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds

# Backend API Configuration
# For iOS simulator and web: http://localhost:5001
# For Android emulator: http://localhost:5001 (auto-converted to 10.0.2.2:5001)
# For physical Android device on same network: http://192.168.1.X:5001
# NOTE: React Native Android cannot reach localhost:5001 directly
# It automatically converts to 10.0.2.2 for emulator
# For physical device: Find your machine IP with ipconfig (Windows) or ifconfig (Mac/Linux)
VITE_API_BASE_URL=http://localhost:5001

# Optional: Override machine IP for physical Android devices
# Uncomment and set to your machine's local network IP
# VITE_MACHINE_IP=192.168.1.100

# API Request Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Socket.IO Configuration (usually same as API base URL)
VITE_SOCKET_URL=http://localhost:5001

# Google Maps API Keys
# Get these from: https://cloud.google.com/console
VITE_GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_GOOGLE_MAPS_API_KEY

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=false
VITE_ENABLE_MOCK_DATA=false

# Environment Type (development|production)
VITE_ENV=development
